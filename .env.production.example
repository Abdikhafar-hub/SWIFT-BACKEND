# Swift Doc Backend Production Environment Configuration
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Base Domain URLs
PUBLIC_SITE_URL=https://swiftdoc.co.ke
APP_URL=https://app.swiftdoc.co.ke
CORS_ORIGIN=https://swiftdoc.co.ke,https://app.swiftdoc.co.ke

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://swiftdoc_user:STRONG_SECURE_PASSWORD@127.0.0.1:5432/swift_doc?schema=public

# Authentication & JWT Secrets (Change for production)
JWT_SECRET=PROD_HIGH_ENTROPY_JWT_ACCESS_SECRET_MIN_32_CHARS_REQUIRED
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=PROD_HIGH_ENTROPY_JWT_REFRESH_SECRET_MIN_32_CHARS_REQUIRED
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Storage (Cloudinary Production Credentials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Resend Production Credentials)
RESEND_API_KEY=re_123456789_your_production_key
RESEND_FROM_EMAIL=notifications@swiftdoc.co.ke

# SMS (Africa's Talking Production Credentials)
AT_API_KEY=your_at_production_api_key
AT_USERNAME=your_at_username
AT_SENDER_ID=SWIFTDOC

# Payments (Safaricom M-Pesa Daraja Production Credentials)
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=your_production_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_production_mpesa_consumer_secret
MPESA_SHORTCODE=your_production_shortcode
MPESA_PASSKEY=your_production_passkey
MPESA_CALLBACK_URL=https://app.swiftdoc.co.ke/api/v1/payments/callbacks/mpesa
