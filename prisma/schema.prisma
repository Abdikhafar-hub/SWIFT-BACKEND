// Swift Doc Production Database Schema — Phase 2 (Operational Application Engine & Workflow Automation)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  CLIENT
  ADMIN
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
  ORGANIZATION
}

enum CommunicationChannel {
  EMAIL
  SMS
  IN_APP
  WHATSAPP
}

enum RequirementType {
  DOCUMENT
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum RequirementStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUIRED
}

enum ApplicationStatus {
  NEW
  QUALIFICATION
  REQUIREMENTS_PENDING
  DOCUMENT_REVIEW
  READY_FOR_SUBMISSION
  SUBMITTED
  GOVERNMENT_PROCESSING
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  DOCUMENT_RECEIVED
  QUALITY_CHECK
  READY_FOR_DELIVERY
  DELIVERED
  CLOSED
  ON_HOLD
  CANCELLED
}

enum ApplicationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SlaStatus {
  ON_TRACK
  AT_RISK
  OVERDUE
  COMPLETED
}

enum GovernmentStatus {
  NOT_STARTED
  PREPARING
  READY_TO_SUBMIT
  SUBMISSION_IN_PROGRESS
  SUBMITTED
  ACKNOWLEDGED
  PAYMENT_REQUIRED
  PAYMENT_PENDING
  UNDER_PROCESSING
  QUERY_RAISED
  ADDITIONAL_INFORMATION_REQUIRED
  CORRECTION_REQUIRED
  APPOINTMENT_REQUIRED
  INTERVIEW_REQUIRED
  BIOMETRICS_REQUIRED
  ON_HOLD
  APPROVED
  REJECTED
  CERTIFICATE_READY
  READY_FOR_COLLECTION
  COLLECTED
  CLOSED
  WITHDRAWN
  CANCELLED
  UNKNOWN
}

enum GovernmentSubmissionChannel {
  ONLINE_PORTAL
  PHYSICAL_OFFICE
  EMAIL
  COURIER
  MANUAL_COUNTER
  THIRD_PARTY
}

enum GovernmentQueryType {
  MISSING_DOCUMENT
  INCORRECT_INFORMATION
  PAYMENT_ISSUE
  IDENTITY_VERIFICATION
  ADDITIONAL_INFORMATION
  CORRECTION_REQUIRED
  APPOINTMENT_REQUIRED
  TECHNICAL_PORTAL_ISSUE
  OTHER
}

enum GovernmentQuerySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GovernmentPaymentStatus {
  NOT_REQUIRED
  REQUIRED
  AWAITING_PAYMENT
  PAID
  FAILED
  REFUNDED
}

enum GovernmentAppointmentType {
  BIOMETRICS
  PASSPORT_COLLECTION
  VISA_INTERVIEW
  GOVERNMENT_OFFICE_VISIT
  DOCUMENT_COLLECTION
  IDENTITY_VERIFICATION
  OTHER
}

enum GovernmentAppointmentStatus {
  SCHEDULED
  ATTENDED
  MISSED
  RESCHEDULED
  CANCELLED
}

enum GovernmentFollowUpMethod {
  PORTAL
  EMAIL
  PHONE_CALL
  PHYSICAL_VISIT
  SMS
  OFFICIAL_LETTER
  CLIENT_COMMUNICATION
  OTHER
}

enum ClientActionType {
  UPLOAD_DOCUMENT
  REPLACE_DOCUMENT
  PROVIDE_INFORMATION
  CONFIRM_INFORMATION
  MAKE_PAYMENT
  APPROVE_DECLARATION
  SIGN_DECLARATION
  OTHER
}

enum ClientActionStatus {
  OPEN
  COMPLETED
  EXPIRED
  CANCELLED
}

enum SlaEventCategory {
  INTERNAL
  CLIENT_WAITING
  GOVERNMENT_WAITING
}

enum SlaEventType {
  STARTED
  PAUSED
  RESUMED
  STATUS_CHANGE
  EXTENSION
  DEADLINE_RECALCULATED
  COMPLETED
}

enum NoteVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum DocumentStatus {
  UPLOADED
  PENDING_REVIEW
  APPROVED
  REJECTED
  REPLACED
  ARCHIVED
}

enum PaymentMethod {
  MPESA
  CASH
  BANK
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAYMENT_UNDER_REVIEW
  PAID
  OVERDUE
  VOID
}

enum PaymentProofStatus {
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum InvoiceLineItemCategory {
  GOVERNMENT_FEE
  SERVICE_FEE
  EXPEDITED_FEE
  COURIER_FEE
  DOCUMENT_AUTHENTICATION
  ADDITIONAL_SERVICE
  TAX
  DISCOUNT
  OTHER
}

enum TransactionType {
  PAYMENT
  REVERSAL
  REFUND
}

enum RefundStatus {
  DRAFT
  PENDING_APPROVAL
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
  FAILED
}

enum AdjustmentType {
  DISCOUNT
  WAIVER
  CORRECTION
  ADDITIONAL_CHARGE
  FEE_ADJUSTMENT
}

enum ReconciliationStatus {
  MATCHED
  UNMATCHED
  DUPLICATE
  SUSPICIOUS
  REVERSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum DeliveryMethod {
  DIGITAL
  PHYSICAL
  BOTH
}

enum QCResult {
  PASSED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==========================================
// 1. ORGANIZATION BOUNDARY
// ==========================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  address     String?
  currency    String   @default("KES")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 User[]
  clients               Client[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  applications          Application[]
  documents             Document[]
  payments              Payment[]
  paymentTransactions   PaymentTransaction[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  applicationMessages   ApplicationMessage[]
  qualityChecks         QualityCheck[]
  applicationDeliveries ApplicationDelivery[]
  clientActions         ClientAction[]
  idempotencyRecords    IdempotencyRecord[]
  backgroundJobs        BackgroundJob[]
  invoiceLineItems      InvoiceLineItem[]
  paymentAllocations    PaymentAllocation[]
  paymentProofSubmissions PaymentProofSubmission[]
  receipts              Receipt[]
  refunds               Refund[]
  financialAdjustments  FinancialAdjustment[]
  reconciliationRecords ReconciliationRecord[]

  @@map("organizations")
}

// ==========================================
// 2. USERS & AUTHENTICATION
// ==========================================

model User {
  id                   String     @id @default(uuid())
  organizationId       String
  email                String     @unique
  passwordHash         String
  role                 UserRole   @default(CLIENT)
  isActive             Boolean    @default(true)
  isEmailVerified      Boolean    @default(false)
  emailVerifiedAt      DateTime?
  otpHash              String?
  otpExpiresAt         DateTime?
  otpAttempts          Int        @default(0)
  otpResendAfter       DateTime?
  onboardingCompleted  Boolean    @default(false)
  onboardingCompletedAt DateTime?
  lastLoginAt          DateTime?
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  firstName            String?
  lastName             String?
  phone                String?
  avatarUrl            String?
  jobTitle             String?
  department           String?
  pendingEmail         String?
  pendingEmailOtpHash  String?
  pendingEmailOtpExpiresAt DateTime?
  pendingEmailOtpAttempts  Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientProfile          Client?                 @relation("UserClientProfile")
  refreshTokens          RefreshToken[]
  assignedApplications   Application[]           @relation("AssignedAdminApplications")
  applicationAssignments ApplicationAssignment[] @relation("AdminAssigned")
  createdAssignments    ApplicationAssignment[] @relation("AdminAssigner")
  applicationNotes       ApplicationNote[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  uploadedDocVersions    DocumentVersion[]       @relation("UploadedBy")
  reviewedDocVersions    DocumentVersion[]       @relation("ReviewedBy")
  reviewedRequirements   ApplicationRequirement[] @relation("ReviewedRequirements")
  submittedGovApps       GovernmentApplication[] @relation("SubmittedGovApps")
  primaryGovApps         GovernmentApplication[] @relation("PrimaryGovOfficer")
  secondaryGovApps       GovernmentApplication[] @relation("SecondaryGovOfficer")
  supervisedGovApps      GovernmentApplication[] @relation("GovSupervisor")
  ownedGovFollowUps      GovernmentApplication[] @relation("GovFollowUpOwner")
  resolvedGovQueries     GovernmentQuery[]       @relation("ResolvedGovQueries")
  createdGovQueries      GovernmentQuery[]       @relation("CreatedGovQueries")
  createdGovAppointments GovernmentAppointment[] @relation("CreatedGovAppointments")
  paidGovPayments        GovernmentPayment[]     @relation("PaidGovPayments")
  uploadedGovEvidence    GovernmentEvidence[]    @relation("UploadedGovEvidence")
  performedGovFollowUps  GovernmentFollowUp[]    @relation("PerformedGovFollowUps")
  sentMessages           ApplicationMessage[]    @relation("SentMessages")
  performedQCs           QualityCheck[]          @relation("PerformedQCs")
  dispatchedDeliveries   ApplicationDelivery[]   @relation("DispatchedDeliveries")
  createdClientActions   ClientAction[]          @relation("CreatedClientActions")
  completedClientActions ClientAction[]          @relation("CompletedClientActions")
  requestedRefunds       Refund[]                @relation("RequestedRefunds")
  approvedRefunds        Refund[]                @relation("ApprovedRefunds")
  createdAdjustments     FinancialAdjustment[]   @relation("CreatedAdjustments")
  reconciledRecords      ReconciliationRecord[]  @relation("ReconciledRecords")
  reviewedClients        Client[]                @relation("ClientReviewer")
  reviewedPaymentProofs  PaymentProofSubmission[] @relation("PaymentProofReviewer")

  @@index([organizationId, role])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  sessionId         String?   @default(uuid())
  familyId          String?   @default(uuid())
  tokenHash         String    @unique
  deviceInfo        String?
  ipAddress         String?
  isRevoked         Boolean   @default(false)
  lastActivityAt    DateTime  @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([sessionId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ==========================================
// 3. CLIENT DOMAIN
// ==========================================

model Client {
  id                           String               @id @default(uuid())
  organizationId               String
  userId                       String?              @unique
  clientNumber                 String               @unique // e.g. SD-CL-000001
  clientType                   ClientType           @default(INDIVIDUAL)
  fullName                     String
  businessName                 String?
  email                        String
  phone                        String
  alternatePhone               String?
  nationality                  String               @default("Kenyan")
  nationalId                   String?
  passportNumber               String?
  kraPin                       String?
  address                      String?
  county                       String?
  city                         String?
  postalAddress                String?
  preferredCommunicationChannel CommunicationChannel @default(EMAIL)
  isDuplicateFlagged           Boolean              @default(false)
  duplicateReason              String?
  isReviewed                   Boolean              @default(false)
  reviewedAt                   DateTime?
  reviewedById                 String?
  reviewNotes                  String?
  isActive                     Boolean              @default(true)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  deletedAt                    DateTime?

  organization                 Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                         User?                @relation("UserClientProfile", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy                   User?                @relation("ClientReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  applications                 Application[]
  documents                    Document[]
  payments                     Payment[]
  paymentTransactions          PaymentTransaction[]
  notifications                Notification[]
  receipts                     Receipt[]
  refunds                      Refund[]
  paymentProofSubmissions      PaymentProofSubmission[]

  @@index([organizationId, clientNumber])
  @@index([organizationId, isReviewed])
  @@index([email])
  @@index([phone])
  @@index([nationalId])
  @@index([kraPin])
  @@index([businessName])
  @@map("clients")
}

// ==========================================
// 4. SERVICE CATALOG & CONFIGURABLE REQUIREMENTS
// ==========================================

model ServiceCategory {
  id             String    @id @default(uuid())
  organizationId String
  code           String    @unique // e.g. CAT-BR (Business Registration)
  slug           String    @unique // e.g. business-registration
  name           String
  description    String?
  icon           String?
  displayOrder   Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]

  @@index([organizationId, active])
  @@map("service_categories")
}

model Service {
  id                                  String             @id @default(uuid())
  organizationId                      String
  categoryId                          String
  code                                String             @unique // e.g. SRV-BR-001
  slug                                String             @unique // e.g. company-incorporation
  name                                String
  description                         String?
  active                              Boolean            @default(true)
  publiclyVisible                     Boolean            @default(true)
  estimatedDuration                   String?            // e.g. "3-7 working days"
  slaHours                            Int                @default(72)
  requiresGovernmentProcess           Boolean            @default(true)
  requiresDocumentReview              Boolean            @default(true)
  requiresPayment                     Boolean            @default(true)
  governmentFee                       Decimal            @default(0.00) @db.Decimal(12, 2)
  serviceFee                          Decimal            @default(0.00) @db.Decimal(12, 2)
  currency                            String             @default("KES")
  displayOrder                        Int                @default(0)
  defaultGovernmentAgency             String?
  defaultGovernmentPlatform           String?
  requiresFullPaymentBeforeSubmission Boolean            @default(true)
  requiresGovernmentTrackingNumber    Boolean            @default(true)
  requiresFinalDocument               Boolean            @default(true)
  pauseSlaOnGovernmentProcessing      Boolean            @default(false)
  pauseSlaOnClientAction              Boolean            @default(true)
  expiryValidityMonths                Int?
  createdAt                           DateTime           @default(now())
  updatedAt                           DateTime           @updatedAt
  deletedAt                           DateTime?

  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category                  ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requirements              ServiceRequirement[]
  applications              Application[]

  @@index([organizationId, active])
  @@index([categoryId])
  @@index([slug])
  @@map("services")
}

model ServiceRequirement {
  id            String          @id @default(uuid())
  serviceId     String
  code          String          // e.g. REQ-DIRECTOR-ID
  name          String          // e.g. "National ID or Passport for Directors"
  description   String?
  type          RequirementType @default(DOCUMENT)
  required      Boolean         @default(true)
  options       Json?           // For SELECT/MULTI_SELECT options
  fileTypes     Json?           // Array of allowed mime types / extensions e.g. ["pdf", "jpg", "png"]
  maxFileSizeMb Int             @default(10)
  displayOrder  Int             @default(0)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  service       Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, code])
  @@index([serviceId, active])
  @@map("service_requirements")
}

// ==========================================
// 5. APPLICATION DOMAIN (CENTRAL BUSINESS ENTITY)
// ==========================================

model Application {
  id                  String              @id @default(uuid())
  organizationId      String
  clientId            String
  serviceId           String
  assignedAdminId     String?
  applicationNumber   String              @unique // e.g. SD-APP-2026-000001
  status              ApplicationStatus   @default(NEW)
  priority            ApplicationPriority @default(NORMAL)
  slaStatus           SlaStatus           @default(ON_TRACK)
  startedAt           DateTime            @default(now())
  dueAt               DateTime?
  completedAt         DateTime?
  submittedAt         DateTime?
  pausedAt            DateTime?
  totalPausedDuration Int                 @default(0) // Paused duration in minutes
  deliveredAt         DateTime?
  notesSummary        String?
  totalAmount         Decimal             @default(0.00) @db.Decimal(12, 2)
  paidAmount          Decimal             @default(0.00) @db.Decimal(12, 2)
  dueAmount           Decimal             @default(0.00) @db.Decimal(12, 2)
  currency            String              @default("KES")
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service             Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedAdmin       User?               @relation("AssignedAdminApplications", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  requirements        ApplicationRequirement[]
  assignments         ApplicationAssignment[]
  activities          ApplicationActivity[]
  notes               ApplicationNote[]
  governmentApps      GovernmentApplication[]
  documents           Document[]
  payments            Payment[]
  paymentTransactions PaymentTransaction[]
  notifications       Notification[]
  messages            ApplicationMessage[]
  qualityChecks       QualityCheck[]
  deliveries          ApplicationDelivery[]
  clientActions       ClientAction[]
  slaEvents           ApplicationSlaEvent[]
  receipts            Receipt[]
  paymentProofSubmissions PaymentProofSubmission[]

  @@index([organizationId, status])
  @@index([clientId, status])
  @@index([assignedAdminId, status])
  @@index([applicationNumber])
  @@index([createdAt])
  @@index([dueAt])
  @@map("applications")
}

// Requirement Snapshot (cloned from ServiceRequirement at application creation time)
model ApplicationRequirement {
  id                   String                   @id @default(uuid())
  applicationId        String
  serviceRequirementId String?                  // Link to original requirement template if needed
  code                 String
  name                 String
  description          String?
  type                 RequirementType          @default(DOCUMENT)
  required             Boolean                  @default(true)
  displayOrder         Int                      @default(0)
  isSatisfied          Boolean                  @default(false)
  status               RequirementStatus        @default(PENDING)
  valueText            String?
  valueNumber          Decimal?                 @db.Decimal(12, 2)
  valueDate            DateTime?
  valueBoolean         Boolean?
  valueJson            Json?
  rejectionReason      String?
  reviewNotes          String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  satisfiedAt          DateTime?
  satisfiedById        String?
  verifiedAt           DateTime?
  verifiedById         String?
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  application          Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy           User?                    @relation("ReviewedRequirements", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents            Document[]
  reviewHistory        RequirementReviewHistory[]
  clientActions        ClientAction[]

  @@index([applicationId, isSatisfied])
  @@index([applicationId, status])
  @@map("application_requirements")
}

model RequirementReviewHistory {
  id                       String                 @id @default(uuid())
  applicationRequirementId String
  actorId                  String?
  actorRole                UserRole?
  action                   String                 // "SUBMIT", "UPDATE", "APPROVE", "REJECT", "REQUEST_CORRECTION"
  previousValue            Json?
  newValue                 Json?
  status                   RequirementStatus
  reason                   String?
  notes                    String?
  createdAt                DateTime               @default(now())

  requirement              ApplicationRequirement @relation(fields: [applicationRequirementId], references: [id], onDelete: Cascade)

  @@index([applicationRequirementId])
  @@index([createdAt])
  @@map("requirement_review_histories")
}

model ApplicationAssignment {
  id              String      @id @default(uuid())
  applicationId   String
  assignedAdminId String
  assignedById    String
  assignedAt      DateTime    @default(now())
  unassignedAt    DateTime?
  reason          String?
  createdAt       DateTime    @default(now())

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignedAdmin   User        @relation("AdminAssigned", fields: [assignedAdminId], references: [id], onDelete: Cascade)
  assignedBy      User        @relation("AdminAssigner", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([assignedAdminId])
  @@map("application_assignments")
}

model ApplicationActivity {
  id            String         @id @default(uuid())
  applicationId String
  actorId       String?
  actorRole     UserRole?
  action        String         // e.g. "STATUS_TRANSITION", "ASSIGNMENT", "DOCUMENT_UPLOAD", "PAYMENT", "GOVERNMENT_SUBMISSION"
  entityType    String?        // e.g. "Application", "Document", "Payment", "GovernmentApplication", "Delivery"
  entityId      String?
  fromStatus    String?
  toStatus      String?
  message       String
  metadata      Json?
  visibility    NoteVisibility @default(CLIENT_VISIBLE)
  createdAt     DateTime       @default(now())

  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, visibility])
  @@index([createdAt])
  @@map("application_activities")
}

model ApplicationNote {
  id            String         @id @default(uuid())
  applicationId String
  authorId      String
  visibility    NoteVisibility @default(INTERNAL)
  content       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId, visibility])
  @@map("application_notes")
}

model GovernmentApplication {
  id                               String                      @id @default(uuid())
  applicationId                    String
  platform                         String                      // e.g. "eCitizen", "BRS", "iTax", "TIMS", "Immigration", "DCI", "MFA"
  governmentAgency                 String                      @default("eCitizen")
  governmentService                String?
  department                       String?
  submissionChannel                GovernmentSubmissionChannel @default(ONLINE_PORTAL)
  externalReference                String?                     // Primary tracking reference e.g. BRS-2026-0001
  trackingNumber                   String?                     // Supplemental tracking number / docket number
  receiptNumber                    String?
  officerContact                   String?
  portalUrl                        String?
  submittedAt                      DateTime?
  submittedByAdminId               String?
  primaryOfficerId                 String?
  secondaryOfficerId               String?
  supervisorId                     String?
  team                             String?
  status                           GovernmentStatus            @default(NOT_STARTED)
  statusDescription                String?
  lastCheckedAt                    DateTime?
  expectedTurnaroundDays           Int?
  expectedResponseDate             DateTime?
  nextFollowUpDate                 DateTime?
  followUpFrequencyDays            Int                         @default(7)
  lastFollowUpDate                 DateTime?
  followUpOwnerId                  String?
  expectedCompletionAt             DateTime?
  approvalDate                     DateTime?
  completionDate                   DateTime?
  completedAt                      DateTime?
  rejectionReason                  String?
  rejectedAt                       DateTime?
  additionalInformationRequired    Boolean                     @default(false)
  additionalInformationRequestedAt DateTime?
  additionalInformationDeadline    DateTime?
  statutoryPaymentStatus           GovernmentPaymentStatus     @default(NOT_REQUIRED)
  statutoryFeeAmount               Decimal                     @default(0.00) @db.Decimal(12, 2)
  isSlaPaused                      Boolean                     @default(false)
  slaPauseReason                   String?
  evidenceDocumentUrl              String?
  notes                            String?
  metadata                         Json?
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt

  application                      Application                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  submittedByAdmin                 User?                       @relation("SubmittedGovApps", fields: [submittedByAdminId], references: [id], onDelete: SetNull)
  primaryOfficer                   User?                       @relation("PrimaryGovOfficer", fields: [primaryOfficerId], references: [id], onDelete: SetNull)
  secondaryOfficer                 User?                       @relation("SecondaryGovOfficer", fields: [secondaryOfficerId], references: [id], onDelete: SetNull)
  supervisor                       User?                       @relation("GovSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  followUpOwner                    User?                       @relation("GovFollowUpOwner", fields: [followUpOwnerId], references: [id], onDelete: SetNull)

  statusHistory                    GovernmentStatusHistory[]
  references                       GovernmentReference[]
  queries                          GovernmentQuery[]
  appointments                     GovernmentAppointment[]
  payments                         GovernmentPayment[]
  evidenceDocs                     GovernmentEvidence[]
  followUps                        GovernmentFollowUp[]

  @@index([applicationId])
  @@index([externalReference])
  @@index([trackingNumber])
  @@index([status])
  @@index([nextFollowUpDate])
  @@index([primaryOfficerId])
  @@index([statutoryPaymentStatus])
  @@map("government_applications")
}

model GovernmentReference {
  id                      String                @id @default(uuid())
  governmentApplicationId String
  referenceType           String                // e.g. "ECITIZEN_REF", "BRS_APP_NO", "KRA_REF", "TIMS_NO", "PASSPORT_NO"
  referenceValue          String
  issuingPlatform         String?               // e.g. "eCitizen", "BRS", "iTax"
  metadata                Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  governmentApplication   GovernmentApplication @relation(fields: [governmentApplicationId], references: [id], onDelete: Cascade)

  @@index([governmentApplicationId])
  @@index([referenceValue])
  @@map("government_references")
}

model GovernmentStatusHistory {
  id                      String                @id @default(uuid())
  governmentApplicationId String
  fromStatus              GovernmentStatus?
  toStatus                GovernmentStatus
  statusDescription       String?
  notes                   String?
  changedById             String?
  source                  String                @default("ADMIN") // "ADMIN", "GOVERNMENT_CALLBACK", "SYSTEM", "IMPORT"
  externalReference       String?
  createdAt               DateTime              @default(now())

  governmentApplication   GovernmentApplication @relation(fields: [governmentApplicationId], references: [id], onDelete: Cascade)

  @@index([governmentApplicationId])
  @@index([createdAt])
  @@map("government_status_histories")
}

model GovernmentQuery {
  id                      String                  @id @default(uuid())
  governmentApplicationId String
  queryType               GovernmentQueryType     @default(OTHER)
  severity                GovernmentQuerySeverity @default(MEDIUM)
  referenceNumber         String?
  receivedAt              DateTime                @default(now())
  responseDeadline        DateTime?
  description             String
  internalNotes           String?
  clientActionId          String?
  isResolved              Boolean                 @default(false)
  resolvedAt              DateTime?
  resolvedById            String?
  resolutionNotes         String?
  createdById             String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  governmentApplication   GovernmentApplication   @relation(fields: [governmentApplicationId], references: [id], onDelete: Cascade)
  clientAction            ClientAction?           @relation(fields: [clientActionId], references: [id], onDelete: SetNull)
  resolvedBy              User?                   @relation("ResolvedGovQueries", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdBy               User?                   @relation("CreatedGovQueries", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([governmentApplicationId])
  @@index([clientActionId])
  @@index([isResolved])
  @@map("government_queries")
}

model GovernmentAppointment {
  id                      String                      @id @default(uuid())
  governmentApplicationId String
  appointmentType         GovernmentAppointmentType   @default(GOVERNMENT_OFFICE_VISIT)
  authorityName           String
  scheduledAt             DateTime
  location                String?
  referenceNumber         String?
  officerContact          String?
  status                  GovernmentAppointmentStatus @default(SCHEDULED)
  clientInstructions      String?
  requiredDocuments       Json?
  isClientVisible         Boolean                     @default(true)
  reminderSent            Boolean                     @default(false)
  createdById             String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  governmentApplication   GovernmentApplication       @relation(fields: [governmentApplicationId], references: [id], onDelete: Cascade)
  createdBy               User?                       @relation("CreatedGovAppointments", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([governmentApplicationId])
  @@index([scheduledAt])
  @@index([status])
  @@map("government_appointments")
}

model GovernmentPayment {
  id                      String                  @id @default(uuid())
  governmentApplicationId String
  amount                  Decimal                 @default(0.00) @db.Decimal(12, 2)
  currency                String                  @default("KES")
  paymentMethod           PaymentMethod           @default(MPESA)
  paymentReference        String?
  paymentDate             DateTime                @default(now())
  receiptNumber           String?
  paidById                String?
  receiptDocumentUrl      String?
  status                  GovernmentPaymentStatus @default(PAID)
  notes                   String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  governmentApplication   GovernmentApplication   @relation(fields: [governmentApplicationId], references: [id], onDelete: Cascade)
  paidBy                  User?                   @relation("PaidGovPayments", fields: [paidById], references: [id], onDelete: SetNull)

  @@index([governmentApplicationId])
  @@index([paymentReference])
  @@map("government_payments")
}

model GovernmentEvidence {
  id                      String                @id @default(uuid())
  governmentApplicationId String
  documentName            String
  documentType            String                // e.g. "ACKNOWLEDGEMENT", "PAYMENT_RECEIPT", "SCREENSHOT", "QUERY_LETTER", "APPROVAL_LETTER", "CERTIFICATE"
  fileUrl                 String
  uploadedById            String?
  uploadedAt              DateTime              @default(now())
  visibility              NoteVisibility        @default(CLIENT_VISIBLE)
  createdAt               DateTime              @default(now())

  governmentApplication   GovernmentApplication @relation(fields: [governmentApplicationId], references: [id], onDelete: Cascade)
  uploadedBy              User?                 @relation("UploadedGovEvidence", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([governmentApplicationId])
  @@map("government_evidence")
}

model GovernmentFollowUp {
  id                      String                   @id @default(uuid())
  governmentApplicationId String
  attemptedAt             DateTime                 @default(now())
  method                  GovernmentFollowUpMethod @default(PHONE_CALL)
  contactPerson           String?
  officeContacted         String?
  outcome                 String?
  notes                   String?
  nextFollowUpDate        DateTime?
  performedById           String?
  createdAt               DateTime                 @default(now())

  governmentApplication   GovernmentApplication    @relation(fields: [governmentApplicationId], references: [id], onDelete: Cascade)
  performedBy             User?                    @relation("PerformedGovFollowUps", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([governmentApplicationId])
  @@index([attemptedAt])
  @@map("government_follow_ups")
}

// ==========================================
// 6. APPLICATION-LINKED COMMUNICATION
// ==========================================

model ApplicationMessage {
  id             String                        @id @default(uuid())
  organizationId String
  applicationId  String
  senderId       String
  senderRole     UserRole                      @default(CLIENT)
  visibility     NoteVisibility                @default(CLIENT_VISIBLE)
  subject        String?
  channel        NotificationChannel           @default(IN_APP)
  sendEmail      Boolean                       @default(false)
  sendSms        Boolean                       @default(false)
  emailMessageId String?
  smsMessageId   String?
  isStarred      Boolean                       @default(false)
  message        String
  isRead         Boolean                       @default(false)
  readAt         DateTime?
  createdAt      DateTime                      @default(now())

  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application                   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender         User                          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  attachments    ApplicationMessageAttachment[]

  @@index([applicationId, visibility])
  @@index([organizationId])
  @@index([createdAt])
  @@index([senderId])
  @@map("application_messages")
}

model ApplicationMessageAttachment {
  id        String             @id @default(uuid())
  messageId String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime           @default(now())

  message   ApplicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("application_message_attachments")
}

// ==========================================
// 7. QUALITY CHECK (PRE-DELIVERY QA)
// ==========================================

model QualityCheck {
  id             String       @id @default(uuid())
  organizationId String
  applicationId  String
  reviewerId     String
  result         QCResult     @default(PASSED)
  checklist      Json?        // { clientMatch: true, documentsLegible: true, correctService: true, requiredPagesPresent: true, govDocVerified: true }
  notes          String?
  failedReason   String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer       User         @relation("PerformedQCs", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([organizationId])
  @@map("quality_checks")
}

// ==========================================
// 8. DELIVERY MANAGEMENT
// ==========================================

model ApplicationDelivery {
  id                 String         @id @default(uuid())
  organizationId     String
  applicationId      String
  deliveryMethod     DeliveryMethod @default(DIGITAL)
  recipientName      String
  recipientPhone     String
  recipientEmail     String?
  physicalAddress    String?
  dispatchReference  String?        // e.g. "SD-DISP-2026-0001"
  trackingNumber     String?        // Courier tracking number (e.g. Fargo, G4S, Speedaf)
  carrier            String?        // "FARGO_COURIER", "G4S", "RIDER", "DIRECT_COLLECTION"
  deliveredAt        DateTime?
  deliveredById      String?
  confirmationStatus String         @default("PENDING") // "PENDING", "DISPATCHED", "CONFIRMED"
  proofDocumentUrl   String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application        Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  deliveredBy        User?          @relation("DispatchedDeliveries", fields: [deliveredById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([organizationId])
  @@index([dispatchReference])
  @@map("application_deliveries")
}

// ==========================================
// 9. DOCUMENT DOMAIN
// ==========================================

model Document {
  id                       String         @id @default(uuid())
  organizationId           String
  clientId                 String
  applicationId            String?
  applicationRequirementId String?
  documentType             String         // e.g. "NATIONAL_ID", "KRA_PIN", "PASSPORT_PHOTO", "CERTIFICATE"
  title                    String
  currentVersionId         String?
  status                   DocumentStatus @default(UPLOADED)
  isArchived               Boolean        @default(false)
  expiresAt                DateTime?
  isExpired                Boolean        @default(false)
  documentNumber           String?
  issuingAuthority         String?
  issuedAt                 DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  deletedAt                DateTime?

  organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                   Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  application              Application?            @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationRequirement   ApplicationRequirement? @relation(fields: [applicationRequirementId], references: [id], onDelete: SetNull)
  versions                 DocumentVersion[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([applicationId])
  @@index([applicationRequirementId])
  @@index([expiresAt])
  @@map("documents")
}

model DocumentVersion {
  id              String    @id @default(uuid())
  documentId      String
  versionNumber   Int       @default(1)
  storageProvider String    @default("CLOUDINARY") // "CLOUDINARY" | "MOCK"
  storageKey      String    // Cloudinary public ID or file path
  secureUrl       String    // Signed/Secure URL
  fileName        String
  fileSize        Int       // Size in bytes
  mimeType        String
  fileExtension   String
  checksum        String?
  uploadedById    String?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime  @default(now())

  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy      User?     @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy      User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

// ==========================================
// 10. PAYMENT DOMAIN (FINANCIAL OPERATIONS)
// ==========================================

model Payment {
  id             String               @id @default(uuid())
  organizationId String
  clientId       String
  applicationId  String
  invoiceNumber  String               @unique // e.g. SD-INV-2026-000001
  currency       String               @default("KES")
  subtotal       Decimal              @default(0.00) @db.Decimal(12, 2)
  governmentFee  Decimal              @default(0.00) @db.Decimal(12, 2)
  serviceFee     Decimal              @default(0.00) @db.Decimal(12, 2)
  otherFee       Decimal              @default(0.00) @db.Decimal(12, 2)
  discount       Decimal              @default(0.00) @db.Decimal(12, 2)
  tax            Decimal              @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal              @default(0.00) @db.Decimal(12, 2)
  amountPaid     Decimal              @default(0.00) @db.Decimal(12, 2)
  amountDue      Decimal              @default(0.00) @db.Decimal(12, 2)
  status         PaymentStatus        @default(PENDING)
  isOverdue      Boolean              @default(false)
  notes          String?
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  application    Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  transactions   PaymentTransaction[]
  lineItems      InvoiceLineItem[]
  allocations    PaymentAllocation[]
  receipts       Receipt[]
  refunds        Refund[]
  adjustments    FinancialAdjustment[]
  proofSubmissions PaymentProofSubmission[]

  @@index([organizationId, status])
  @@index([organizationId, isOverdue])
  @@index([clientId])
  @@index([applicationId])
  @@index([dueAt])
  @@index([issuedAt])
  @@map("payments")
}

model PaymentProofSubmission {
  id              String             @id @default(uuid())
  organizationId  String
  paymentId       String
  clientId        String
  applicationId   String?
  paymentMethod   PaymentMethod      @default(BANK)
  claimedAmount   Decimal            @db.Decimal(12, 2)
  paymentDate     DateTime           @default(now())
  referenceNumber String?
  notes           String?
  proofFileKey    String?
  proofFileName   String
  proofFileSize   Int
  proofMimeType   String
  status          PaymentProofStatus @default(PENDING_REVIEW)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment         Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  application     Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  reviewedBy      User?              @relation("PaymentProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([paymentId])
  @@index([clientId])
  @@map("payment_proof_submissions")
}

model PaymentTransaction {
  id                String               @id @default(uuid())
  paymentId         String
  organizationId    String
  clientId          String
  applicationId     String?
  transactionNumber String               @unique // e.g. SD-TX-2026-000001
  transactionType   TransactionType      @default(PAYMENT)
  paymentMethod     PaymentMethod        @default(MPESA)
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("KES")
  status            PaymentStatus        @default(PENDING)
  idempotencyKey    String               @unique
  externalReference String?              // e.g. M-Pesa receipt code "QHG581290"
  providerReference String?              // e.g. Daraja CheckoutRequestID
  providerResponse  Json?
  phoneNumber       String?              // For M-Pesa STK
  paidAt            DateTime?
  reversalOfId      String?
  reversalReason    String?
  reversedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  application       Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  reversalOf        PaymentTransaction?  @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversals         PaymentTransaction[] @relation("TransactionReversal")
  allocations       PaymentAllocation[]
  receipt           Receipt?
  refunds           Refund[]
  reconciliationRecords ReconciliationRecord[]

  @@index([paymentId])
  @@index([externalReference])
  @@index([providerReference])
  @@index([idempotencyKey])
  @@index([reversalOfId])
  @@map("payment_transactions")
}

model InvoiceLineItem {
  id              String                  @id @default(uuid())
  paymentId       String
  organizationId  String
  description     String
  category        InvoiceLineItemCategory @default(SERVICE_FEE)
  quantity        Int                     @default(1)
  unitAmount      Decimal                 @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal                 @default(0.00) @db.Decimal(12, 2)
  isGovernmentFee Boolean                 @default(false)
  isTaxable       Boolean                 @default(false)
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  payment         Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([organizationId])
  @@map("invoice_line_items")
}

model PaymentAllocation {
  id             String             @id @default(uuid())
  transactionId  String
  paymentId      String
  organizationId String
  amount         Decimal            @db.Decimal(12, 2)
  allocatedAt    DateTime           @default(now())
  createdAt      DateTime           @default(now())

  transaction    PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  payment        Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([paymentId])
  @@index([organizationId])
  @@map("payment_allocations")
}

model Receipt {
  id                   String             @id @default(uuid())
  organizationId       String
  clientId             String
  applicationId        String
  paymentId            String
  transactionId        String             @unique
  receiptNumber        String             @unique // e.g. SD-RCP-2026-000001
  amount               Decimal            @db.Decimal(12, 2)
  currency             String             @default("KES")
  paymentMethod        PaymentMethod      @default(MPESA)
  transactionReference String?            // e.g. M-Pesa receipt code
  payerName            String
  amountPaid           Decimal            @db.Decimal(12, 2)
  remainingBalance     Decimal            @db.Decimal(12, 2)
  issuedAt             DateTime           @default(now())
  metadata             Json?
  createdAt            DateTime           @default(now())

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  application          Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  payment              Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transaction          PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
  @@index([applicationId])
  @@index([paymentId])
  @@index([receiptNumber])
  @@map("receipts")
}

model Refund {
  id                    String             @id @default(uuid())
  organizationId        String
  clientId              String
  paymentId             String
  transactionId         String
  refundNumber          String             @unique // e.g. SD-RF-2026-000001
  amount                Decimal            @db.Decimal(12, 2)
  currency              String             @default("KES")
  reason                String
  reasonCategory        String?            // "CLIENT_OVERPAYMENT", "DUPLICATE_PAYMENT", "SERVICE_CANCELLATION", "SERVICE_NOT_DELIVERED", "GOVERNMENT_FEE_ADJUSTMENT", "INCORRECT_BILLING", "FAILED_SERVICE_PROCESSING", "GOODWILL_ADJUSTMENT", "OTHER"
  refundMethod          PaymentMethod      @default(MPESA)
  status                RefundStatus       @default(PENDING_APPROVAL)
  
  // Method specific details
  recipientPhone        String?
  bankName              String?
  accountHolder         String?
  accountNumber         String?
  referenceDetails      String?

  // Supporting info
  internalNotes         String?
  supportingDocumentUrl String?
  clientExplanation     String?

  // Lifecycle actors & timestamps
  requestedById         String
  approvedById          String?
  approvedAt            DateTime?
  processingStartedAt   DateTime?
  processedAt           DateTime?
  completedById         String?
  completedAt           DateTime?
  rejectedById          String?
  rejectedAt            DateTime?
  rejectionReason       String?
  cancelledById         String?
  cancelledAt           DateTime?
  failedAt              DateTime?
  failureReason         String?

  externalReference     String?            // M-Pesa reversal ref or bank reference
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  payment               Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transaction           PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  requestedBy           User               @relation("RequestedRefunds", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy            User?              @relation("ApprovedRefunds", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@index([paymentId])
  @@index([transactionId])
  @@index([refundNumber])
  @@index([status])
  @@index([reasonCategory])
  @@map("refunds")
}

model FinancialAdjustment {
  id               String         @id @default(uuid())
  organizationId   String
  paymentId        String
  adjustmentNumber String         @unique // e.g. SD-ADJ-2026-000001
  type             AdjustmentType @default(DISCOUNT)
  amount           Decimal        @db.Decimal(12, 2) // positive for additions, negative for reductions
  reason           String
  createdById      String
  appliedAt        DateTime       @default(now())
  metadata         Json?
  createdAt        DateTime       @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment          Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdBy        User           @relation("CreatedAdjustments", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([paymentId])
  @@index([adjustmentNumber])
  @@map("financial_adjustments")
}

model ReconciliationRecord {
  id             String               @id @default(uuid())
  organizationId String
  reference      String               // M-Pesa Receipt or Statement ref
  transactionId  String?
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @default("KES")
  provider       String               @default("MPESA")
  status         ReconciliationStatus @default(UNMATCHED)
  reconciledAt   DateTime?
  reconciledById String?
  notes          String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction    PaymentTransaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  reconciledBy   User?                @relation("ReconciledRecords", fields: [reconciledById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([reference])
  @@index([transactionId])
  @@index([status])
  @@map("reconciliation_records")
}

// ==========================================
// 11. NOTIFICATIONS
// ==========================================

model Notification {
  id             String              @id @default(uuid())
  organizationId String
  userId         String
  clientId       String?
  applicationId  String?
  channel        NotificationChannel @default(IN_APP)
  type           String              // e.g. "APPLICATION_CREATED", "DOCUMENT_APPROVED", "PAYMENT_RECEIVED", "SLA_WARNING"
  title          String
  message        String
  status         NotificationStatus  @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  templateKey    String?
  readAt         DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client         Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  application    Application?        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([organizationId])
  @@index([applicationId])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  emailEnabled               Boolean  @default(true)
  smsEnabled                 Boolean  @default(true)
  inAppEnabled               Boolean  @default(true)
  marketingEnabled           Boolean  @default(false)
  emailOperationalAlerts     Boolean  @default(true)
  emailClientRegistrations   Boolean  @default(true)
  emailApplicationAlerts     Boolean  @default(true)
  emailPaymentNotifications  Boolean  @default(true)
  emailClientActions         Boolean  @default(true)
  emailSlaAlerts             Boolean  @default(true)
  emailSecurityNotifications Boolean  @default(true)
  inAppOperationalAlerts     Boolean  @default(true)
  inAppAssignments           Boolean  @default(true)
  inAppClientActions         Boolean  @default(true)
  inAppSlaAlerts             Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ==========================================
// 12. IMMUTABLE AUDIT LOG
// ==========================================

model AuditLog {
  id              String    @id @default(uuid())
  organizationId  String
  actorId         String?
  actorName       String?
  actorEmail      String?
  actorRole       UserRole?
  action          String    // e.g. "USER_LOGIN", "APPLICATION_CREATED", "DOCUMENT_APPROVED", etc.
  actionCategory  String?   // e.g. "AUTH", "APPLICATION", "DOCUMENT", "QUALITY_CONTROL", "GOVERNMENT", "FINANCIAL", etc.
  description     String?   // Human-readable description
  resource        String    // Alias / legacy field for entityType e.g. "Application"
  resourceId      String?   // Alias / legacy field for entityId
  entityType      String?   // e.g. "User", "Client", "Application", "Document", "Invoice", "Payment", "Refund", "Delivery"
  entityId        String?   // ID of affected entity
  entityReference String?   // Human reference code e.g. "SD-APP-2026-000124", "admin@swiftdoc.co.ke"
  previousValue   Json?
  newValue        Json?
  status          String?   @default("SUCCESS") // "SUCCESS" | "FAILURE" | "WARNING" | "INFO"
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resource, resourceId])
  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([actionCategory])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// 13. IDEMPOTENCY RECORD
// ==========================================

model IdempotencyRecord {
  id             String        @id @default(uuid())
  organizationId String?
  key            String        @unique
  resource       String        // e.g. "PAYMENT_CALLBACK", "SLA_JOB", "NOTIFICATION"
  resourceId     String?
  responseBody   Json?
  status         String        @default("COMPLETED") // "PROCESSING", "COMPLETED", "FAILED"
  createdAt      DateTime      @default(now())
  expiresAt      DateTime

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ==========================================
// 14. BACKGROUND JOBS
// ==========================================

model BackgroundJob {
  id               String        @id @default(uuid())
  organizationId   String?
  queueName        String        @default("default")
  jobType          String        // "SLA_SWEEP", "GOV_FOLLOWUP_SWEEP", "SEND_EMAIL", "SEND_SMS", "CLIENT_REMINDER"
  deduplicationKey String?       @unique
  payload          Json
  status           JobStatus     @default(PENDING)
  attempts         Int           @default(0)
  maxAttempts      Int           @default(3)
  lastError        String?
  scheduledAt      DateTime      @default(now())
  processedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([jobType])
  @@index([deduplicationKey])
  @@map("background_jobs")
}

// ==========================================
// 15. CLIENT ACTIONS (ACTIONABLE REQUESTS)
// ==========================================

model ClientAction {
  id              String              @id @default(uuid())
  organizationId  String
  applicationId   String
  requirementId   String?
  type            ClientActionType    @default(PROVIDE_INFORMATION)
  title           String
  description     String
  priority        ApplicationPriority @default(NORMAL)
  dueAt           DateTime?
  status          ClientActionStatus  @default(OPEN)
  createdById     String?
  completedAt     DateTime?
  completedById   String?
  completionNotes String?
  responsePayload Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application     Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement     ApplicationRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation("CreatedClientActions", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy     User?               @relation("CompletedClientActions", fields: [completedById], references: [id], onDelete: SetNull)
  governmentQueries GovernmentQuery[]

  @@index([organizationId, status])
  @@index([applicationId, status])
  @@index([dueAt])
  @@map("client_actions")
}

// ==========================================
// 16. APPLICATION SLA EVENTS & TIMING HISTORY
// ==========================================

model ApplicationSlaEvent {
  id              String           @id @default(uuid())
  applicationId   String
  eventType       SlaEventType     @default(STATUS_CHANGE)
  category        SlaEventCategory @default(INTERNAL)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  durationMinutes Int              @default(0)
  reason          String?
  actorId         String?
  actorRole       UserRole?
  metadata        Json?
  createdAt       DateTime         @default(now())

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([category])
  @@index([createdAt])
  @@map("application_sla_events")
}

