# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swift_doc?schema=public

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_access_key_swift_doc_2026_dev_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_swift_doc_2026_dev_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret

# Email (Resend)
RESEND_API_KEY=mock_resend_api_key
RESEND_FROM_EMAIL=notifications@swiftdoc.co.ke

# SMS (Africa's Talking)
AT_API_KEY=mock_at_api_key
AT_USERNAME=mock_at_username
AT_SENDER_ID=SWIFTDOC

# Payments (Safaricom M-Pesa Daraja)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=mock_mpesa_consumer_key
MPESA_CONSUMER_SECRET=mock_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=mock_mpesa_passkey
MPESA_CALLBACK_URL=https://api.swiftdoc.co.ke/api/v1/payments/callbacks/mpesa
